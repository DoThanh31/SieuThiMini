<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SieuThiMini</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SieuThiMini.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    🛒 SieuThiMini
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Bật/tắt thanh điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-white-50" title="Chức năng thuộc Module 2">Sản phẩm</span>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link text-white-50" title="Chức năng thuộc Module 3">Nhập hàng</span>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link text-white-50" title="Chức năng thuộc Module 4">Bán hàng (POS)</span>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link text-white-50" title="Chức năng thuộc Module 5">Báo cáo</span>
                                </li>
                            }
                            else if (User.IsInRole("Cashier"))
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-white-50" title="Chức năng thuộc Module 4">Bán hàng (POS)</span>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        <partial name="_Notifications" />
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 text-muted mt-auto">
        <div class="container text-center small">
            &copy; 2026 - SieuThiMini - Hệ thống quản lý siêu thị mini
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
